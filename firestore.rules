rules_version = '2';

/**
 * Digital Gram Panchayat — Firestore security rules.
 *
 * Phase 2: the `users` collection (profiles / roles).
 * Phase 3: the `applications` collection and its `statusHistory` subcollection.
 * Phase 5: role-based access for staff and admin.
 *
 * Roles live in users/{uid}.role ("citizen" | "staff" | "admin") and an
 * account can be switched off with users/{uid}.active = false. Neither field
 * can be written from the browser — staff/admin accounts are created and
 * managed only through the server-side /api/admin/* functions (Firebase
 * Admin SDK, which bypasses these rules), and the first admin is created by
 * scripts/create-first-admin.js. An account with no `active` field (all
 * accounts created before Phase 5) counts as active.
 *
 * Staff and admin may READ applications, but every application status change
 * is made by /api/staff/update-application-status (validated transitions +
 * history entry), so clients can never update or delete an application.
 *
 * Paste this into: Firebase Console → Firestore Database → Rules → Publish
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // The caller has a profile and has not been deactivated.
    function isActiveUser() {
      return request.auth != null
          && exists(userPath(request.auth.uid))
          && get(userPath(request.auth.uid)).data.get('active', true) != false;
    }

    function hasRole(role) {
      return isActiveUser() && get(userPath(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaffOrAdmin() {
      return hasRole('staff') || hasRole('admin');
    }

    // ---- users -----------------------------------------------------------

    match /users/{userId} {

      // A signed-in user may read their own profile; an admin may read any
      // profile. (The admin pages use the API for listing, so this is a
      // backstop rather than the main path.)
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());

      // Registration: a user may create ONLY their own profile, with role
      // "citizen", and ONLY the fields the registration form produces. This
      // stops anyone registering as staff/admin (or pre-setting `active`)
      // by editing client-side JavaScript.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'citizen'
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.mobile is string
                    && request.resource.data.keys().hasOnly(['name', 'mobile', 'email', 'role', 'createdAt']);

      // A user may update their own profile but can never change their own
      // role or active flag (so a citizen cannot promote themselves, and a
      // deactivated account cannot re-activate itself).
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('active', null) == resource.data.get('active', null);

      // Accounts are never deleted from the client.
      allow delete: if false;
    }

    // ---- staff availability ("I Am Here") --------------------------------
    // Both collections are read and written ONLY by /api/availability (Firebase
    // Admin SDK, which bypasses these rules). The API checks the caller's role,
    // writes with server timestamps, and hands citizens a minimal summary, so
    // clients get no direct access at all: a citizen cannot change availability
    // and nobody can read staff entries straight from Firestore.
    match /settings/{settingId} {
      allow read, write: if false;
    }
    match /staffAvailability/{staffId} {
      allow read, write: if false;
    }

    // ---- applications ----------------------------------------------------

    match /applications/{applicationId} {

      // Applications are created ONLY by /api/applications/submit (Admin SDK, which
      // bypasses these rules). The server checks every required document, ties each
      // file to its checklist item, takes the applicant identity from the signed-in
      // account and fixes the status to "submitted" — none of which a browser could be
      // trusted to do. So nothing may be created from the client.
      allow create: if false;

      // Owners read their own applications (list queries must be scoped with
      // where("userId","==",uid)). Active staff and admins read all.
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isStaffOrAdmin());

      // No client-side updates or deletes — status changes go through
      // /api/staff/update-application-status.
      allow update: if false;
      allow delete: if false;

      match /statusHistory/{historyId} {

        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/applications/$(applicationId)).data.userId == request.auth.uid
                        || isStaffOrAdmin());

        // History entries are written by the server (submit, status changes, document
        // requests and reviews), never by the browser.
        allow create: if false;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
