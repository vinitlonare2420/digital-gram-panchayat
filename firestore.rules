rules_version = '2';

/**
 * Digital Gram Panchayat — Firestore security rules.
 *
 * Phase 2 added: the `users` collection (profiles / roles).
 * Phase 3 adds:  the `applications` collection and its
 *                `statusHistory` subcollection (citizen-facing rules only
 *                — staff read/write access is Phase 5, and is NOT granted
 *                here, so no staff account can yet read or change any
 *                application through these rules).
 *
 * This is a starting point for a college project, not a claim of
 * production-grade security. Paste this into:
 *   Firebase Console → Firestore Database → Rules
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // A signed-in user may read only their own profile document.
      // (Staff-wide user listing is not needed in Phase 2 and is not
      // granted here; add a narrower rule later if a staff directory
      // view is introduced.)
      allow read: if request.auth != null && request.auth.uid == userId;

      // Account creation: a user may create ONLY their own profile
      // document (id must match their own uid), and only with role
      // "citizen". This is what stops someone from registering
      // themselves as staff by editing client-side JavaScript — the
      // request is rejected server-side regardless of what the client
      // sends.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'citizen'
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.mobile is string;

      // Updates: a user may update their own profile, but never change
      // their own role — the role field must stay exactly what it
      // already was. This blocks a citizen from promoting themselves to
      // staff after registration, and blocks a staff account from
      // demoting/altering its own role, from the client.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      // No client-side deletes. Remove or disable accounts from the
      // Firebase Console / Admin SDK instead.
      allow delete: if false;
    }

    match /applications/{applicationId} {

      // A citizen may create an application only as themselves, and only
      // in the initial "submitted" state — Phase 3 has no path for a
      // citizen to create an application that is already Approved,
      // Rejected, or Under Review. Basic shape checks stop obviously
      // malformed writes (missing service info, non-map formData).
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.applicationId is string
                    && request.resource.data.serviceType is string
                    && request.resource.data.serviceName is string
                    && request.resource.data.formData is map;

      // A citizen may read only their own applications. Because
      // getMyApplications() always queries with
      // where("userId","==",currentUser.uid), Firestore can prove every
      // possible result satisfies this rule and allows the list query;
      // a query that is NOT scoped that way (e.g. trying to list every
      // application to check for an ID collision) is correctly rejected.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Phase 3 citizens only submit applications — they never edit one
      // afterwards. In particular this blocks a citizen from changing
      // their own application's status, remarks, or ownership. Staff
      // update access (approve/reject/correction/remarks) is introduced
      // in Phase 5 and is intentionally NOT part of these rules yet.
      allow update: if false;

      // No client-side deletes.
      allow delete: if false;

      match /statusHistory/{historyId} {

        // Readable/creatable only by the owner of the parent application
        // (looked up via get(), since userId lives on the parent doc, not
        // on the history entry itself).
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/applications/$(applicationId)).data.userId == request.auth.uid;

        allow create: if request.auth != null
                      && get(/databases/$(database)/documents/applications/$(applicationId)).data.userId == request.auth.uid
                      && request.resource.data.status is string;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
