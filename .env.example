# Environment variables for Digital Gram Panchayat — NAMES ONLY, never real values.
#
# WHERE THEY GO
#   Vercel (primary host):  Project → Settings → Environment Variables. Add every variable below to
#                           Production AND Preview (Development too if you use `vercel dev`).
#   Local development:      copy this file to .env.local (git-ignored) and fill it in, then run
#                           `npm run dev:api`. Never commit .env.local.
#
# These are SERVER-SIDE ONLY. No frontend file reads them; only the functions under /api and the
# helper scripts in scripts/ do. Never prefix them with NEXT_PUBLIC_ / VITE_, never paste them into
# a page, and never log them. The GitHub Pages static backup uses NONE of them.

# ---------------------------------------------------------------- Supabase (private document storage)

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key. Grants full access to the Supabase project — the most sensitive value
# here. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon (publishable) key. Safe to be public in principle, but it is kept server-side here
# and only relayed in the create-upload-url response — see api/documents/create-upload-url.js for why
# the browser's direct signed-upload PUT needs it as an `apikey` header.
SUPABASE_ANON_KEY=

# Name of the PRIVATE Storage bucket for uploaded documents. Optional: defaults to gp-documents.
SUPABASE_BUCKET=gp-documents

# ---------------------------------------------------------------- Firebase Admin (server-side)

# Firebase service-account credentials as one JSON string (Firebase Console → Project settings →
# Service accounts → Generate new private key; paste the whole file content as the value). Used by
# firebase-admin to verify sign-in tokens and read/write Firestore from the backend only.
# ROTATE this key (generate a new one, then revoke the old) before going public if it was ever
# exposed. Never commit it, and never paste it into chat, pages or logs.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---------------------------------------------------------------- NOT Vercel variables (for reference)
#
# PRIMARY_APP_URL is a GitHub *repository variable* (Settings → Secrets and variables → Actions →
# Variables), read only by .github/workflows/static.yml so the static backup can link to the main
# application. It is a public web address, not a secret, and Vercel does not need it:
#
#   PRIMARY_APP_URL=https://<your-vercel-domain>
